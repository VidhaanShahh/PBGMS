# =================================================================
# PBGMS (Pet Boarding & Grooming Management System) - Backend Environment Configuration
# Safe production example template (Never commit real secret credentials)
# =================================================================

# Server & Runtime Configuration
NODE_ENV=production
PORT=5000
HOST=0.0.0.0

# CORS Configuration (Set to your Netlify frontend URL; comma-separated for multiple origins)
CLIENT_URL=https://pbgms.netlify.app,http://localhost:5173

# Authentication / JWT Security Secret (Use a strong cryptographically generated string in production)
JWT_SECRET=replace_with_a_long_random_jwt_secret_key_minimum_32_characters

# Database Persistence Configuration (SQLite)
# For Render / Docker with persistent disk, set absolute mount path (e.g. /var/data/pbgms.sqlite)
SQLITE_DB_NAME=pbgms.sqlite
SQLITE_DB_PATH=/var/data/pbgms.sqlite

# Persistent Uploads Directory (Set to persistent disk path for uploaded pet photos)
UPLOADS_DIR=/var/data/uploads

# Razorpay Payment Gateway (Test Mode / Production Credentials)
# Leave empty to use PBGMS College Presentation Demo Mode (SIM- prefixed payments)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYMENT_GATEWAY_LIVE=false

# Optional External Notifications (Email / SMS)
# If omitted or unconfigured, all notifications are safely logged to database with QUEUED_NO_PROVIDER status
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
